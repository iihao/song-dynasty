{"id":"lit-menglianglu","cat":"literature","type":"笔记","name":"《梦粱录》","era":"南宋","year":null,"endYear":null,"ptype":null,"birth":null,"death":null,"summary":"吴自牧记述南宋临安城市生活的笔记，仿《东京梦华录》而作，保存大量都城史料。","tags":["笔记","南宋","临安","城市"],"groups":[],"minor":false,"detail":"全书二十卷，记临安岁时、物产、街巷、店铺、百工、杂戏、寺观、学校、科举等，尤详于节令风俗与市井生活。书中“夜市”“诸色杂货”“瓦舍众伎”等条，是研究南宋城市经济与市民文化的重要资料。","body":null,"refs":"《梦粱录》","categoryName":"名篇","createdAt":"2026-11-06 09:09:35","updatedAt":"2026-11-06 09:09:35","related":[{"id":"cus-chasi","name":"茶肆与茶馆","cat":"customs"},{"id":"cus-linan-suishi","name":"临安岁时","cat":"customs"},{"id":"cus-yuanxiao","name":"元宵节","cat":"customs"},{"id":"geo-linan","name":"临安府","cat":"geography"},{"id":"lit-dongjingmenghualu","name":"《东京梦华录》","cat":"literature"},{"id":"ppl-wuzimu","name":"吴自牧","cat":"people"}],"sources":[]}