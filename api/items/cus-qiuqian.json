{"id":"cus-qiuqian","cat":"customs","type":"游艺","name":"秋千与斗草","era":"两宋","year":null,"endYear":null,"ptype":null,"birth":null,"death":null,"summary":"宋代春季流行荡秋千、斗草，士女竞相游乐，是寒食清明时节的代表性活动。","tags":["秋千","两宋","节令","斗草"],"groups":[],"minor":false,"detail":"秋千以彩绳悬木、女子坐立其上，荡越高低为戏；斗草分“文斗”与“武斗”，以草名对答或拉扯草茎比韧。汴京、临安春日，仕女出郊荡秋千、斗草、蹴鞠、放风筝，形成热闹的春游图景。这些活动兼具竞技、审美与社交功能。","body":null,"refs":"《东京梦华录》；《武林旧事》","categoryName":"风俗生活","createdAt":"2026-11-06 09:09:35","updatedAt":"2026-11-06 09:09:35","related":[{"id":"cus-cuju","name":"蹴鞠","cat":"customs"},{"id":"cus-huazhao","name":"花朝节","cat":"customs"},{"id":"cus-qingming","name":"清明与寒食","cat":"customs"},{"id":"cus-shangsi","name":"上巳节","cat":"customs"}],"sources":[]}